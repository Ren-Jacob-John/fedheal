# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit real secrets.

# local | development | test | staging | production. UNSET means production
# (fails closed): missing/placeholder secrets stop the app from starting.
FEDHEAL_ENV=development

# This service is INTERNAL — only Module 1 calls /validate/*. Module 1
# mints a short-lived, hospital-scoped token per upload; this is the key it
# is signed with. MUST equal module1-auth's FEDHEAL_SVC_SIGNING_KEY_M1_M2.
# Required in staging/production: >= 32 random characters.
FEDHEAL_SVC_SIGNING_KEY_M1_M2=change-me-to-a-real-secret

# Outbound: flag/reject reports to Module 7. MUST equal module7-admin's
# FEDHEAL_SVC_KEY_M2_M7.
FEDHEAL_SVC_KEY_M2_M7=change-me-to-a-real-secret
FEDHEAL_ADMIN_API_URL=http://localhost:8005

# Optional request limits (defaults shown). Keep >= module1-auth's.
# FEDHEAL_MAX_JSON_BODY_BYTES=5242880
# FEDHEAL_MAX_CSV_BYTES=5242880
# FEDHEAL_MAX_RECORDS=5000
# FEDHEAL_MAX_RECORD_FIELDS=50
# FEDHEAL_MAX_FIELD_CHARS=256
