rules_version = '2';
// FedHeal never lets a browser or mobile client talk to Firestore directly.
// Every read and write goes through the Module 1 / Module 7 APIs, which run with
// a service account (the Admin credentials bypass these rules) and enforce
// tenant isolation per hospital_id in application code.
// Denying all client access means a leaked web config or a mistaken SDK
// call in the dashboard cannot read patient data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
