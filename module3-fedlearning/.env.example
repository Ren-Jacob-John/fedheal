# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit real secrets.

# local | development | test | staging | production. UNSET means production.
FEDHEAL_ENV=development
FEDHEAL_AUTH_API_URL=http://localhost:8001

# --- Module 3 -> Module 1 credential (pick the one that fits the machine) ---
# A HOSPITAL's own client (client_runner.py): one pre-minted token for THAT
# hospital only, issued by the platform operator with
#   python module1-auth/mint_service_token.py --hospital-id <id>
# It cannot read any other hospital's data (Module 1 answers 403).
# FEDHEAL_SVC_TOKEN_M3_M1=

# Optional hospital-scoped Module 3 -> Module 7 retraining queue token,
# minted by module7-admin/mint_retraining_runner_token.py. Used only with
# client_runner.py --watch-retraining; do not place the signing key here.
# FEDHEAL_SVC_TOKEN_M3_M7=
# FEDHEAL_ADMIN_API_URL=http://localhost:8005

# Optional experimental client-side update transformation (both default off).
# This does not provide an epsilon-DP guarantee; no accountant is implemented.
# FEDHEAL_UPDATE_CLIP_NORM=1.0
# FEDHEAL_UPDATE_NOISE_MULTIPLIER=0.0

# Legacy centralized pooling is disabled; do not mint multi-hospital tokens
# for that path. The platform-side Flower server may need this signing key
# only for trusted service operations. Never put it on a hospital client.
# MUST equal module1-auth's FEDHEAL_SVC_SIGNING_KEY_M3_M1.
# FEDHEAL_SVC_SIGNING_KEY_M3_M1=

# Outbound round reports to Module 7. MUST equal module7-admin's FEDHEAL_SVC_SIGNING_KEY_M3_M7.
# FEDHEAL_SVC_SIGNING_KEY_M3_M7=
