# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit real secrets.

# local | development | test | staging | production. UNSET means production.
FEDHEAL_ENV=development
FEDHEAL_AUTH_API_URL=http://localhost:8001

# --- Module 3 -> Module 1 credential (pick the one that fits the machine) ---
# A HOSPITAL's own client (client_runner.py): one pre-minted token for THAT
# hospital only, issued by the platform operator with
#   python module1-auth/mint_service_token.py --hospital-id <id>
# It cannot read any other hospital's data (Module 1 answers 403).
# FEDHEAL_SVC_TOKEN_M3_M1=

# The central OPERATOR's pooled simulation (simulate_real.py) mints a token
# per hospital itself. Never put this key on a hospital-side machine.
# MUST equal module1-auth's FEDHEAL_SVC_SIGNING_KEY_M3_M1.
# FEDHEAL_SVC_SIGNING_KEY_M3_M1=

# Outbound round reports to Module 7. MUST equal module7-admin's FEDHEAL_SVC_KEY_M3_M7.
# FEDHEAL_SVC_KEY_M3_M7=
