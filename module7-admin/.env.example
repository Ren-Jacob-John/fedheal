# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit credentials or service-account keys.

# ---- Database: Firebase Firestore --------------------------------------------------
# Same settings as module1-auth/.env.example. Development with FEDHEAL_DB_BACKEND unset
# uses a local JSON-file store (./fedheal_admin_store.json). Staging/production require:
#   FEDHEAL_DB_BACKEND=firestore
#   FEDHEAL_FIREBASE_PROJECT_ID=your-firebase-project-id
#   GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Module 7's collections (training_rounds, validation_flags, model_versions) don't collide with
# Module 1's, so both can share one Firestore database. To give this service its own named
# database instead, set FEDHEAL_ADMIN_FIRESTORE_DATABASE=<name>.
FEDHEAL_DB_BACKEND=local
# FEDHEAL_LOCAL_STORE_PATH=./fedheal_admin_store.json

# local | development | test | staging | production. UNSET means production
# (fails closed): missing/placeholder secrets stop the app from starting.
FEDHEAL_ENV=development

# Browser origin(s) of the dashboard (https:// required in staging/production).
FEDHEAL_DASHBOARD_ORIGIN=http://localhost:5173

# MUST match module1-auth's FEDMED_JWT_SECRET — this service only verifies
# tokens, never issues them.
FEDMED_JWT_SECRET=change-me-to-a-real-secret

# Per-caller service keys — MUST match the corresponding value each
# caller sends, but the two are independent of each other and of Module
# 1's signing keys (which this service doesn't use at all).
# Required in staging/production: >= 32 random characters.
# MUST match module2-validation's FEDHEAL_SVC_SIGNING_KEY_M2_M7 (signs hospital-scoped flag-report tokens):
FEDHEAL_SVC_SIGNING_KEY_M2_M7=change-me-to-a-real-secret
# MUST match module3-fedlearning's FEDHEAL_SVC_SIGNING_KEY_M3_M7 (round + candidate tokens):
FEDHEAL_SVC_SIGNING_KEY_M3_M7=change-me-to-a-real-secret
# Minimum eligible records per threshold bucket for automatic runner requests.
# Unset or 0 disables automatic scheduling. Only counts are received from runners.
# FEDHEAL_RETRAIN_MIN_ELIGIBLE_RECORDS=100
# MUST match module8-synthesis's FEDHEAL_SVC_SIGNING_KEY_M8_M7 (promoted-model reads):
FEDHEAL_SVC_SIGNING_KEY_M8_M7=change-me-to-a-real-secret

# Where Module 1 is reachable, for the hospital-oversight proxy calls.
FEDMED_AUTH_API_URL=http://localhost:8001
