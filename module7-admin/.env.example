# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit real Supabase credentials.

# Reuses the SAME Supabase project as module1-auth (different tables,
# no naming collisions — see database.py's docstring). If you'd rather
# keep Module 7's tables in a separate Supabase project, set
# FEDHEAL_ADMIN_DATABASE_URL instead and it'll take priority over this one.
FEDHEAL_DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# FEDHEAL_ADMIN_DATABASE_URL=postgresql://...  # uncomment to use a separate project

# MUST match module1-auth's FEDMED_JWT_SECRET — this service only verifies
# tokens, never issues them.
FEDMED_JWT_SECRET=change-me-to-a-real-secret

# MUST match module1-auth's/module2-validation's FEDMED_SERVICE_KEY.
FEDMED_SERVICE_KEY=change-me-to-a-real-secret

# Where Module 1 is reachable, for the hospital-oversight proxy calls.
FEDMED_AUTH_API_URL=http://localhost:8001
