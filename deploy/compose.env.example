# Copy to .env at the repo root. Never commit the real file (.env is gitignored).
# Generate each secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FEDHEAL_ENV=staging
POSTGRES_PASSWORD=CHANGE_ME
FEDMED_JWT_SECRET=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M3_M1=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M1_M2=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M2_M7=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M3_M7=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M8_M7=CHANGE_ME
# Public self-registration stays CLOSED (unset). Hospital admins create doctors. Do not enable outside local development.
# FEDHEAL_ALLOW_PUBLIC_REGISTRATION=true
# Origin the browser loads the dashboard from (CORS allow-list).
FEDHEAL_DASHBOARD_ORIGIN=http://localhost:5173
# Module 8 serves the PROMOTED federated model. The demo fallback is OFF everywhere unless you set this
# explicitly; it is then labelled NON-CLINICAL DEMO. Leave unset to get an honest MODEL_UNAVAILABLE.
# FEDHEAL_ALLOW_DEMO_MODEL=true
