# Copy to .env at the repo root. Never commit the real file (.env is gitignored).
# Generate each secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FEDHEAL_ENV=staging
POSTGRES_PASSWORD=CHANGE_ME
FEDMED_JWT_SECRET=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M3_M1=CHANGE_ME
FEDHEAL_SVC_SIGNING_KEY_M1_M2=CHANGE_ME
FEDHEAL_SVC_KEY_M2_M7=CHANGE_ME
FEDHEAL_SVC_KEY_M3_M7=CHANGE_ME
# Origin the browser loads the dashboard from (CORS allow-list).
FEDHEAL_DASHBOARD_ORIGIN=http://localhost:5173
# Module 8 demo model is OFF outside development. Leave unset to get an honest 503.
# FEDHEAL_ALLOW_DEMO_MODEL=true
