# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit real secrets.

# local | development | test | staging | production. UNSET means production
# (fails closed): a missing/placeholder secret stops the app from starting.
FEDHEAL_ENV=development

# Where Module 8 reads stored records from (it forwards the CALLING USER's
# own token — it holds no credential of its own for this).
FEDHEAL_AUTH_API_URL=http://localhost:8001

# The vitals model is a labelled DEMO fallback (public UCI data) until Module 3
# exports a federated global model. On by default in development/test only;
# in staging/production it must be enabled explicitly, otherwise the endpoint
# answers 503 "specialist_unavailable".
# FEDHEAL_ALLOW_DEMO_MODEL=true

# MUST match module1-auth's FEDMED_JWT_SECRET — this service only verifies
# tokens (any logged-in user, no specific role required — see auth.py),
# never issues them. There is exactly one login system in this platform.
FEDMED_JWT_SECRET=change-me-to-a-real-secret

# Comma-separated list of allowed CORS origins (the dashboard's actual
# URL(s)) — same convention as every other FedHeal service. Required and
# https:// in staging/production; "*" is never accepted.
FEDHEAL_DASHBOARD_ORIGIN=http://localhost:5173

# Promoted-model reads from Module 7 (must match module7-admin FEDHEAL_SVC_SIGNING_KEY_M8_M7)
FEDHEAL_SVC_SIGNING_KEY_M8_M7=change-me-to-a-real-secret
FEDHEAL_ADMIN_API_URL=http://localhost:8005
# Explicit, development-only; labelled NON-CLINICAL DEMO when used:
# FEDHEAL_ALLOW_DEMO_MODEL=true
