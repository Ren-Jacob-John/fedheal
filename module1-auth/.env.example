# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit real Supabase credentials.

# From your Supabase project: Project Settings -> Database -> Connection string
# -> "Transaction" pooler (recommended for serverless/short-lived connections)
# or "Session" pooler (recommended for a long-running app like this one).
# Copy the URI, then replace [YOUR-PASSWORD] with your actual database password.
#
# Format looks like:
#   postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Leave this unset (or delete this line) to fall back to local SQLite —
# useful for quick local dev without a Supabase project configured yet.
FEDHEAL_DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Must match across every FedHeal service — this is what verifies JWTs.
FEDMED_JWT_SECRET=change-me-to-a-real-secret

# Shared secret for service-to-service calls (Module 2 -> here, Module 3 -> here).
FEDMED_SERVICE_KEY=change-me-to-a-real-secret

# Where Module 2 (validation) is reachable, for the vitals upload flow.
FEDHEAL_VALIDATION_API_URL=http://localhost:8002
