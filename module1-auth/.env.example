# Copy this file to .env in this same folder and fill in your real values.
# .env is gitignored — never commit credentials or service-account keys.

# ---- Database: Firebase Firestore --------------------------------------------------
# Local development (FEDHEAL_ENV=development) needs NOTHING here: with FEDHEAL_DB_BACKEND
# unset the service uses a local JSON-file store (./fedheal_auth_store.json, gitignored).
#
# Real Firestore (required in staging/production — local stores are refused there):
#   FEDHEAL_DB_BACKEND=firestore
#   FEDHEAL_FIREBASE_PROJECT_ID=your-firebase-project-id
#   GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
#       (or run on Google Cloud with an attached service account and leave this unset)
#   FEDHEAL_FIRESTORE_DATABASE=(default)        # optional named database
# Firebase emulator (local, no Google account):
#   FEDHEAL_DB_BACKEND=firestore  FIRESTORE_EMULATOR_HOST=localhost:8080  FEDHEAL_FIREBASE_PROJECT_ID=demo-fedheal
# Tests / throwaway runs:  FEDHEAL_DB_BACKEND=memory
#
# There are no schema migrations. Deploy firestore.rules and firestore.indexes.json
# (repo root) once per Firebase project — see docs/FIRESTORE_MIGRATION.md.
FEDHEAL_DB_BACKEND=local
# FEDHEAL_LOCAL_STORE_PATH=./fedheal_auth_store.json

# local | development | test | staging | production. If this is UNSET the app
# behaves as PRODUCTION (fails closed): missing/placeholder secrets stop it
# from starting. Use "development" for local work only.
FEDHEAL_ENV=development

# Must match across every FedHeal service — this is what verifies JWTs.
# Required in staging/production: >= 32 random characters, NOT a placeholder.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEDMED_JWT_SECRET=change-me-to-a-real-secret

# Signing keys for the two internal hops Module 1 is part of. Each hop has
# its OWN key so a leak of one is useless on the other.
#   M3 -> M1 (Module 3 reading a hospital's vitals): Module 1 VERIFIES with
#   this key. Hospitals never get this key; they get a hospital-scoped
#   token minted with `python mint_service_token.py --hospital-id <id>`.
FEDHEAL_SVC_SIGNING_KEY_M3_M1=change-me-to-a-real-secret
#   M1 -> M2 (Module 1 forwarding an upload for validation): Module 1 MINTS
#   per-upload tokens with this; Module 2 verifies with the same value.
FEDHEAL_SVC_SIGNING_KEY_M1_M2=change-me-to-a-real-secret
# (FEDHEAL_SVC_KEY_M3_M1, the old single shared key, is retired and ignored.)

# Browser origin(s) of the dashboard, comma-separated. Required in
# staging/production and must be https://. Never "*".
FEDHEAL_DASHBOARD_ORIGIN=http://localhost:5173

# Session cookie "Secure" flag. Forced on in staging/production.
# FEDHEAL_COOKIE_SECURE=false

# Optional upload limits (defaults shown).
# FEDHEAL_MAX_JSON_BODY_BYTES=5242880
# FEDHEAL_MAX_CSV_BYTES=5242880
# FEDHEAL_MAX_RECORDS=5000
# FEDHEAL_MAX_RECORD_FIELDS=50
# FEDHEAL_MAX_FIELD_CHARS=256

# Where Module 2 (validation) is reachable, for the vitals upload flow.
FEDHEAL_VALIDATION_API_URL=http://localhost:8002
