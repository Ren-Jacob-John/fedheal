# Local env files with real secrets — never commit these
.env
server/auth/.env
server/validation/.env
server/admin/.env
server/synthesis/.env

# Local development document stores (FEDHEAL_DB_BACKEND=local) and their lock/temp files
*_store.json
*_store.json.lock
.store-*.tmp
# Legacy SQLite files from before the Firestore migration
*.db

# Python
__pycache__/
*.pyc
.venv/
venv/
.deps/

# Node (if the frontend gets rebuilt in React/Next.js later)
node_modules/
model_artifacts/

firebase_pk.json

# Firebase CLI logs
*-debug.log
